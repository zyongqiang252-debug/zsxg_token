# Optional packaging path for a locally built Linux/amd64 binary with embedded web assets.
ARG BASE_IMAGE=docker.io/library/debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a
FROM ${BASE_IMAGE}
ARG DEBIAN_MIRROR=http://deb.debian.org
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata libasan8 wget \
    && rm -rf /var/lib/apt/lists/*
COPY new-api-linux-amd64 /new-api
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md ledongthuc-pdf-LICENSE /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
